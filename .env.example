# Rate Limiter Settings
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# Analytics Batch Worker Settings
CLICK_FLUSH_INTERVAL_MS=10000
CLICK_BATCH_SIZE=100
