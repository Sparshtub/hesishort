{
  "name": "hesishort",
  "version": "1.0.0",
  "description": "HesiShort — High-Throughput URL Shortener & Analytics Engine with Redis Caching and Asynchronous Ingestion",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "node scripts/testSuite.js",
    "test:load": "autocannon -c 50 -d 10 http://localhost:4000/q0U"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "mysql2": "^3.10.1",
    "nanoid": "^3.3.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "autocannon": "^7.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
